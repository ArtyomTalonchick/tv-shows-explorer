# The Firebase project whose Firestore the local server uses: the same one the deployed function uses, so local
# development changes the real data. Copy this file to `.env`; the credentials come from
# `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=tv-shows-explorer

# The secret that signs the sign-in tokens: any long random string, other than the one in Firebase, so a token made
# locally does not open production. Make one with `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`.
JWT_SECRET=
