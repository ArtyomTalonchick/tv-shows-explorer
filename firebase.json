{
    "hosting": {
        "public": "client/dist",
        "ignore": ["firebase.json", "**/.*"],
        "predeploy": ["npm run build"],
        "rewrites": [
            { "source": "/api/**", "function": { "functionId": "server", "region": "us-central1" } },
            { "source": "**", "destination": "/index.html" }
        ]
    },
    "functions": [
        {
            "source": "server/dist",
            "codebase": "default",
            "runtime": "nodejs22",
            "ignore": ["node_modules"],
            "predeploy": ["npm run build:function -w server", "npm install --prefix server/dist --no-audit --no-fund"]
        }
    ]
}
